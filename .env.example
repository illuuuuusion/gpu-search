# Secrets (DISCORD_BOT_TOKEN, EBAY_CLIENT_SECRET) koennen alternativ per Datei
# gesetzt werden: statt des Werts ein `${NAME}_FILE` mit Pfad angeben, z. B.
# EBAY_CLIENT_SECRET_FILE=/run/secrets/ebay_client_secret (Docker-Secrets).
# Fehlt die Datei, bricht der Start hart ab (Fail-Fast).
EBAY_PROVIDER=mock
EBAY_APP_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_SEARCH_PAGE_SIZE=200
EBAY_MAX_PAGES_PER_BUCKET=3
NOTIFIER_PROVIDER=console
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_STATE_PATH=data/discord-admin-state.json
DISCORD_SEND_DELAY_MS=750
DISCORD_RATE_LIMIT_BUFFER_MS=250
DISCORD_MAX_SEND_RETRIES=5
# Allowlists (komma-separierte User-IDs). ALLOWED_REACTOR_IDS leer -> nutzt ALLOWED_ADMIN_IDS.
ALLOWED_ADMIN_IDS=504707482547912714,689513442867937321
ALLOWED_REACTOR_IDS=
# Reaction-Feedback (A7/B5). REACTIONS_ENABLED aktiviert den GuildMessageReactions-Intent
# und 👍/👎 auf Alerts; ADAPTIVE_THRESHOLD_ENABLED steuert die Bias-Anwendung im Scan.
REACTIONS_ENABLED=false
ADAPTIVE_THRESHOLD_ENABLED=true
# C1 Dream-Deal-Score (nur WORKING-Listings). Startschwelle = Deal-Score in %.
DREAM_DEAL_ENABLED=true
DREAM_DEAL_MIN_SCORE=15
# C2 Fehltreffer melden (🚫 + Textnachricht). Levenshtein permissiv (max. Distanz).
RUNTIME_EXCLUSIONS_ENABLED=true
EXCLUSION_SIMILARITY_MAX_DISTANCE=2
EXCLUSIONS_STATE_PATH=data/runtime-exclusions.json
# D Auktions-Sniper-Reminder (⏰). Fester Lead vor Auktionsende, gemeinsam pro Listing.
AUCTION_REMINDER_ENABLED=true
AUCTION_REMINDER_LEAD_MINUTES=20
AUCTION_REMINDER_CHECK_INTERVAL_SECONDS=60
# B2 Deal-Timing aus eigener Historie (kein eBay Marketplace Insights).
DEAL_TIMING_ENABLED=true
DEAL_TIMING_MIN_SAMPLES=4
# B6 Alias-Fallback (regelbasiert, NUR Logging – kein Live-Alarm, kein Embedding-Modell).
ALIAS_FALLBACK_ENABLED=true
ALIAS_FALLBACK_MIN_SIMILARITY=0.72
ALIAS_FALLBACK_LOG_PATH=data/alias-fallback-log.json
# B4 Cross-Marketplace-Arbitrage (Kleinanzeigen). AUS bis Scraper-Selektoren
# gegen die Live-Seite verifiziert + ToS geklaert sind (siehe TODO).
KLEINANZEIGEN_ENABLED=false
KLEINANZEIGEN_BASE_URL=https://www.kleinanzeigen.de
ARBITRAGE_MIN_MARGIN_EUR=40
ARBITRAGE_RESELL_FEE_PERCENT=12
ARBITRAGE_RESELL_SHIPPING_EUR=8
SCANNER_STATE_PATH=data/scanner-state.json
MARKET_SUMMARY_PATH=data/market-summary.json
# Anzahl rotierter Backups (*.bak.N) je State-Datei; 0 = aus.
SCANNER_STATE_BACKUP_COUNT=3
SCANNER_AVAILABILITY_REFRESH_ENABLED=true
SCANNER_AVAILABILITY_RECHECK_MINUTES=12
SCANNER_AVAILABILITY_UNAVAILABLE_ACTION=delete
SCANNER_SEEN_RETENTION_DAYS=30
SCANNER_STATS_WINDOW_DAYS=90
SCANNER_AVAILABILITY_RECHECK_HOURS=6
SCANNER_AVAILABILITY_CHECK_BATCH_SIZE=25
POLL_INTERVAL_SECONDS=720
# Observability: Prometheus-Pull. OTEL_ENABLED=true oeffnet einen /metrics-Endpunkt
# (Default-Port 9464), lokal scrapebar via: curl localhost:9464/metrics
OTEL_ENABLED=false
OTEL_PROMETHEUS_PORT=9464
ALLOW_COUNTRIES=DE,AT,CH,FR,BE,NL,LU,DK,PL,CZ
MIN_SELLER_FEEDBACK_PERCENT=90
MAX_SHIPPING_HARD_CAP_EUR=25
VALORANT_ENABLED=false
VALORANT_PROVIDER=vlr
VALORANT_STORAGE_PATH=data/valorant-compositions.json
VALORANT_WINDOW_DAYS=90
VALORANT_INGEST_HOUR_UTC=1
VALORANT_RAW_RETENTION_DAYS=7
VALORANT_BUILDER_SESSION_TTL_MINUTES=30
VALORANT_VLR_BASE_URL=https://www.vlr.gg
VALORANT_SYNC_MAX_RETRIES=2
VALORANT_SYNC_RETRY_DELAY_MS=2500
VALORANT_VLR_MIN_REQUEST_INTERVAL_MS=1250
VALORANT_VLR_MAX_EVENT_PAGES=3
VALORANT_VLR_MAX_MATCH_TIMESTAMP_LOOKUPS=60
VALORANT_VLR_RECENT_MATCH_DAYS=45
VALORANT_LIQUIPEDIA_API_BASE_URL=https://liquipedia.net/valorant/api.php
VALORANT_LIQUIPEDIA_USER_AGENT=gpu-search/0.1 (contact: you@example.com)
VALORANT_LIQUIPEDIA_MIN_REQUEST_INTERVAL_MS=3500
