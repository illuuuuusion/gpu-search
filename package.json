{
  "name": "gpu-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "description": "GPU watchlist scanner with eBay search, filtering, scoring and Discord notifications",
  "workspaces": [
    "tools/claude-gpu-search-channel"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/bootstrap.ts",
    "clean": "tsx src/scripts/ops/cleanDist.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/app/bootstrap.js",
    "test": "EBAY_PROVIDER=mock EBAY_HTTP_RETRY_DELAY_MS=1 SCANNER_STATE_PATH=/tmp/gpu-search-test-scanner-state.json MARKET_SUMMARY_PATH=/tmp/gpu-search-test-market-summary.json npm run build && EBAY_PROVIDER=mock EBAY_HTTP_RETRY_DELAY_MS=1 SCANNER_STATE_PATH=/tmp/gpu-search-test-scanner-state.json MARKET_SUMMARY_PATH=/tmp/gpu-search-test-market-summary.json sh -c 'node --test $(find dist -name \"*.test.js\")' && npm run test:sidecar",
    "doctor": "tsx src/scripts/ops/doctor.ts",
    "reset:scanner-state": "node dist/scripts/gpu/resetScannerState.js",
    "test:mock-scan": "npm run build && node dist/scripts/gpu/testMockScan.js",
    "valorant:sync": "node dist/scripts/valorant/valorantSync.js",
    "valorant:fixture-check": "node dist/scripts/valorant/valorantFixtureCheck.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:sidecar": "npm test --workspace claude-gpu-search-channel"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "axios": "^1.9.0",
    "discord.js": "^14.26.3",
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
